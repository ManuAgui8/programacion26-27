Algoritmo Saludar
	
	Definir edad_alumno Como Entero;
	Definir nombre_alumno Como Cadena;
	
	
	Escribir "Hola Manuel Aguilar";
	Escribir 5;
	
	
	Escribir "¿Me dices tu nombre?";
	
	Leer nombre_alumno;
	
	Escribir "¿Me dices tu edad?";
	
	Leer edad_alumno;
	
	Escribir "Tu nombre es ", nombre_alumno, " y tienes ", edad_alumno, " años";
	
	
	
FinAlgoritmo
