Algoritmo Ejercicio_1
	
	Definir num_a Como Entero;
	Definir num_b Como Entero;
	Definir num_aux Como Entero;
	
	Escribir "Introduce el valor de a y de b";
	
	Leer num_a;
	Leer num_b;
	
	
	num_aux = num_a;
	num_a = num_b;
	num_b = num_aux;
	

	
	
	
	
	Escribir "El valor de a es: ", num_a, ", y el valor de b es: ", num_b;
	
FinAlgoritmo
