Algoritmo Ejercicio_2
	
	Definir num_a Como Real;
	Definir num_b Como Real;
	Definir suma Como Real;
	Definir resta Como Real;
	Definir prod Como Real;
	Definir div Como Real;
	
	Escribir "Introduce el numero a y el numero b";
	Leer num_a;
	Leer num_b;
	
	suma = num_a + num_b;
	resta = num_a - num_b;
	prod = num_a * num_b;
	div	= num_a / num_b;
	
	Escribir "La suma de estos numeros es: ", suma;
	Escribir "La resta es: ", resta;
	Escribir "El producto es: ", prod;
	Escribir "La división: ", div;
	
	
FinAlgoritmo
