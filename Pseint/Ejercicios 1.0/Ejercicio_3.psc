Algoritmo Ejercicio_3
	
	Definir num1, num2 Como Real;
	
	Escribir "Dime dos números";
	Leer num1, num2;
	
	Si num1 == num2 Entonces
		Escribir "Los dos numeros son iguales";
	SiNo
		Si num1 > num2 Entonces
			Escribir "El mayor de los dos es: ", num1;
		SiNo
			Escribir "El mayor de los dos es: ", num2;
		FinSi
	FinSi
	
	

FinAlgoritmo
